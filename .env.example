# Copy this file to .env (never commit .env) and fill it in.
# Put comments on their own line, not after a value.

# Generate a secret key with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me

# 1 on your own computer, 0 on the real server
DJANGO_DEBUG=1

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# MongoDB Atlas: in Atlas press Connect -> Drivers, copy the connection string and put your database user's password in it.
# If the password has special characters (@ : / ?), URL-encode them.
MONGODB_URI=mongodb+srv://DB_USER:DB_PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGODB_NAME=formulasphere

# Optional business numbers (these are the defaults)
FS_TRIAL_DAYS=7
FS_PREMIUM_GRANT_DAYS=30
FS_LOCKOUT_LIMIT=5
FS_LOCKOUT_IP_LIMIT=30
FS_LOCKOUT_MINUTES=15
FS_EXPLORE_PAGE_SIZE=12
FS_PANEL_PAGE_SIZE=25
# Slug of the account type used when an old mobile app signs up without choosing one
FS_DEFAULT_ACCOUNT_TYPE=student
# Minutes before a live class when its meeting link appears for registered students
FS_LIVE_JOIN_EARLY_MINUTES=15
# Tuition requests allowed per connection per hour (stops spam)
FS_ENQUIRY_LIMIT=5
# Symbol shown before amounts
FS_CURRENCY_SYMBOL=₹
# Shown to a student after they choose a Premium plan (how to pay you)
FS_PAYMENT_INSTRUCTIONS=Pay by UPI to your-id@bank and enter the payment reference below. Premium starts as soon as the payment is confirmed.

# ---- Added in this update ----
# Public address of the site (used in emails and sitemap.xml)
FS_SITE_URL=http://localhost:8000
# Extra trusted origins for HTTPS forms, comma separated (real server only)
DJANGO_CSRF_TRUSTED_ORIGINS=
# Content protection on formula pages: 1 on, 0 off
FS_PROTECT_CONTENT=1
# Formula pages one non-staff account may open per hour (stops scraping)
FS_VIEW_LIMIT_PER_HOUR=150
# Devices one non-staff account may be signed in on at once (0 = unlimited)
FS_MAX_SESSIONS=2
# Formulas a student may submit per day
FS_SUBMISSIONS_PER_DAY=5
# Email. Leave EMAIL_BACKEND empty in development: emails print in the console.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=FormulaSphere <no-reply@yourdomain.com>
FS_REMINDER_TRIAL_DAYS=2
FS_REMINDER_PREMIUM_DAYS=3
# Razorpay online payment (leave empty to keep manual UPI only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Backups
FS_BACKUP_DIR=backups
FS_BACKUP_KEEP=14
